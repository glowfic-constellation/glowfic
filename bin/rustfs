#!/usr/bin/env bash
set -euo pipefail

data_dir="$(dirname "$0")/../tmp/rustfs-data"
mkdir -p "$data_dir" # rustfs will not create its own data directory

env RUSTFS_ACCESS_KEY=glowfic_minio RUSTFS_SECRET_KEY=glowfic_minio \
  RUSTFS_ADDRESS=:9000 RUSTFS_CONSOLE_ADDRESS=:9001 \
  rustfs "$data_dir"
