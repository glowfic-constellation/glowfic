# frozen_string_literal: true
require 'net/http'
require 'json'
require 'yaml'

namespace :asn do
  desc "Resolve config/blocked_asns.yml to CIDR ranges via RIPEstat and rewrite config/blocked_asn_cidrs.yml"
  task refresh: :environment do
    asn_file = Rails.root.join('config', "blocked_asns.yml")
    out_file = Rails.root.join('config', "blocked_asn_cidrs.yml")

    config = YAML.load_file(asn_file)
    asns = (config['asns'] || []).map { |a| a.is_a?(Hash) ? a['asn'] : a }

    prefixes = []
    asns.each do |asn|
      uri = URI("https://stat.ripe.net/data/announced-prefixes/data.json?resource=AS#{asn}")
      puts "  AS#{asn} → #{uri}"
      # Fail loudly rather than treat an error as "announces nothing", which
      # would silently drop the ASN's prefixes from the blocklist.
      response = Net::HTTP.get_response(uri)
      raise "RIPEstat returned HTTP #{response.code} for AS#{asn}" unless response.is_a?(Net::HTTPSuccess)
      data = JSON.parse(response.body)
      raise "RIPEstat returned status #{data['status'].inspect} for AS#{asn}" unless data['status'] == 'ok'
      raise "RIPEstat response for AS#{asn} has no prefix list" unless data.dig('data', 'prefixes').is_a?(Array)
      announced = data['data']['prefixes'].map { |p| p['prefix'] }
      puts "    #{announced.size} prefixes"
      prefixes.concat(announced)
    end

    cidrs = AsnBlocker.collapse(prefixes)

    # Leave the file (and its timestamps) untouched when nothing changed, so the
    # refresh workflow doesn't open a PR that only bumps generated_at.
    if out_file.exist? && YAML.load_file(out_file)['prefixes'] == cidrs
      puts ""
      puts "#{cidrs.size} CIDRs unchanged; leaving #{out_file.relative_path_from(Rails.root)} as is"
      next
    end

    File.open(out_file, 'w') do |f|
      f.puts "# Auto-generated by `bin/rails asn:refresh` from config/blocked_asns.yml."
      f.puts "# Do not edit by hand; instead edit the ASN list and re-run the task"
      f.puts "# (or trigger the .github/workflows/refresh-asn-cidrs.yml workflow)."
      f.puts "#"
      f.puts "# Resolved from RIPEstat (https://stat.ripe.net) at #{Time.now.utc.strftime('%Y-%m-%dT%H:%MZ')}."
      f.puts "generated_at: \"#{Time.now.utc.iso8601}\""
      f.puts "source: ripestat"
      f.puts "prefixes:"
      cidrs.each { |p| f.puts "  - \"#{p}\"" }
    end

    puts ""
    puts "Wrote #{cidrs.size} CIDRs (collapsed from #{prefixes.size} announced prefixes) to #{out_file.relative_path_from(Rails.root)}"
  end
end
