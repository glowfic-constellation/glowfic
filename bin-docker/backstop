#!/usr/bin/env bash

set -e

NUM_CONTAINERS=$(docker compose ps | wc -l)
DOCKER_COMPOSE="docker compose -f compose.yml -f compose-backstop.yml"
# oxipng 9.1.5, pinned by digest
OXIPNG_IMAGE="ghcr.io/shssoichiro/oxipng@sha256:e1623b0da9f14b63b242ffb78e4eef4ba0f09c9159880d238665af4654c75b4f"

if [ "$1" == 'test' ] || [ "$1" == 'reference' ] && [ "$2" != 'logged_out' ]; then
  $DOCKER_COMPOSE run --rm web bin/rails runner script/before_backstop.rb "$2"
fi
$DOCKER_COMPOSE run --rm backstop --config "$2" "$1" "${@:3}"

# reference and approve write the committed images in backstop/then; shrink the ones that changed (lossless)
if [ "$1" == 'reference' ] || [ "$1" == 'approve' ]; then
  mapfile -t CHANGED < <(git ls-files --modified --others --exclude-standard -- 'backstop/then/*.png' | sed 's|^backstop/then/|/then/|')
  if [ ${#CHANGED[@]} -gt 0 ]; then
    echo "Optimising ${#CHANGED[@]} changed reference image(s) with oxipng"
    docker run --rm --user "$(id -u):$(id -g)" -v "$PWD/backstop/then:/then" "$OXIPNG_IMAGE" -o 4 --strip safe -q "${CHANGED[@]}"
  fi
fi

if [ $NUM_CONTAINERS == 2 ]; then
	docker compose down
fi
