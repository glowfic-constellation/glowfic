= render 'search/breadcrumbs'

%table.search-collapsible
  %thead
    %tr
      %th.search-params-header
        Search Posts
        - if @search_results
          = '- ' + @search_results.total_entries.to_s + ' results'
      %th.search-results-header
        - if @search_results
          = render 'paginator', paginated: @search_results
  %tbody
    %tr
      %td.search-box
        = form_with url: search_posts_path, method: :get do |f|
          %table.search-form
            %tr
              %td.width-70= f.label :board_id, 'Continuity'
              %td= f.select :board_id, options_from_collection_for_select(@board || [], :id, :name, params[:board_id]),
                class: 'chosen-select', prompt: '— Choose Continuity —'
            %tr
              %td= f.label :exclude_board_ids, 'Exclude Continuity'
              %td= f.select :exclude_board_ids, options_from_collection_for_select(@exclude_boards || [], :id, :name, params[:exclude_board_ids]), class: 'chosen-select', prompt: '— Choose Continuity —', multiple: true, name: 'exclude_board_ids[]'
            %tr
              %td= f.label :author_id
              %td= f.select :author_id, options_from_collection_for_select(@user || [], :id, :username, params[:author_id]), class: 'chosen-select', prompt: '— Choose Author —', multiple: true
            %tr
              %td= f.label :character_id
              %td= f.select :character_id, options_from_collection_for_select(@character || [], :id, :selector_name, params[:character_id]),
                prompt: '— Choose Character —'
            %tr
              %td= f.label :setting_id
              %td= f.select :setting_id, options_from_collection_for_select(@setting || [], :id, :name, params[:setting_id]),
                prompt: '— Choose Setting —'
            %tr
              %td= f.label :subject
              %td= f.text_field :subject, value: params[:subject], style: 'width: 100%; margin: 5px 0px;'
            %tr
              %td= f.label :abbrev, 'Acronym'
              %td.padding-5
                = f.check_box :abbrev, checked: params[:abbrev].present?, unchecked_value: nil, class: 'vmid no-margin', style: 'margin-bottom: 3px;'
                = f.label :abbrev, 'Search for acronym'
            %tr
              %td= f.label :exact
              %td.padding-5
                = f.check_box :exact, checked: params[:exact].present?, unchecked_value: nil, class: 'vmid no-margin', style: 'margin-bottom: 3px;'
                = f.label :exact, 'Exact string match'
            %tr
              %td= f.label :completed
              %td.padding-5
                = f.check_box :completed, checked: params[:completed].present?, unchecked_value: nil, class: 'vmid no-margin', style: 'margin-bottom: 3px;'
                = f.label :completed, "Completed Only"
            - if current_user&.hide_from_all
              %tr
                %td= f.label :hide_ignored, 'Ignored'
                %td.padding-5
                  = f.check_box :hide_ignored, checked: !params.key?(:commit) || params[:hide_ignored].present?, unchecked_value: nil, class: 'vmid no-margin', style: 'margin-bottom: 3px;'
                  = f.label :hide_ignored, "Hide ignored posts"
            %tr
              %td.centered{colspan: 2}= f.submit "Search", class: 'button'
      %td.vtop#search_results
        - if @pruned_words.present?
          %p.search-notice
            - if @all_pruned
              All search terms were too common for full-text search
              (#{@pruned_words.map { |w| "\"#{w}\"" }.join(', ')}).
              Falling back to exact string matching.
            - else
              Some search terms were too common for full-text search and were ignored:
              #{@pruned_words.map { |w| "\"#{w}\"" }.join(', ')}.
              Use "Exact string match" to search for the full phrase.
        - if @search_results.present?
          %table
            %thead
              %tr
                %th.sub
                %th.sub Thread
                %th.sub Continuity
                %th.sub Authors
                %th.sub Replies
                %th.sub Last Updated
            %tbody
              = render partial: 'posts/list_item', collection: @search_results, as: :post

  - if @search_results && @search_results.total_pages > 1
    %tfoot
      %tr
        %th.search-params-header.empty
        %th.search-results-header= render 'paginator', paginated: @search_results
